[Unit]
Description=TeamON public Timon web proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/teamon
EnvironmentFile=/etc/teamon/timon-web.env
ExecStart=/usr/bin/node /var/www/teamon/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
